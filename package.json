{
  "name": "mona-radar-company",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run collector:build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "collector:build": "tsc -p collector/tsconfig.json",
    "collector:bundle": "esbuild collector/index.ts --bundle --packages=external --platform=node --format=esm --target=node24 --outfile=runtime/collector.mjs --loader:.sql=text",
    "runtime:prepare": "node tools/prepare-runtime.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "cheerio": "^1.1.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^24.3.0",
    "esbuild": "^0.25.9",
    "playwright": "^1.55.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
